
SECRET_KEY=

DEBUG=on

ALLOWED_HOSTS=localhost,vety-guardian-portal-back.example.fi

# Database
DATABASE_URL=postgres://vetyuser:vetypw@localhost:5433/vetyguardiandb
# Overrides the password in DATABASE_URL when set
DATABASE_PASSWORD=

# Cross-Origin Resource Sharing (django-cors-headers / corsheaders) settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Helsinki-profiili login (Helsinki Tunnistus). Must match the frontend's VITE_OIDC_* settings.
TOKEN_AUTH_ISSUER=https://tunnistus.test.hel.ninja/auth/realms/helsinki-tunnistus
# Client id of this backend in Tunnistus = audience of the API token the frontend sends
TOKEN_AUTH_AUDIENCE=
# Seconds of clock skew tolerated between this server and Tunnistus when validating tokens
OIDC_API_TOKEN_AUTH_LEEWAY=10
HELSINKI_PROFILE_API_URL=https://profile-api.test.hel.ninja/graphql/
HELSINKI_PROFILE_API_AUDIENCE=profile-api-test

# Locize translations for the application PDF. Same project as the frontend's VITE_LOCIZE_PROJECT_ID.
# LOCIZE_CDN_URL must match the frontend's cdnType (src/i18n/i18n.ts):
# "standard" -> https://api.lite.locize.app, "pro" -> https://api.locize.app
LOCIZE_CDN_URL=https://api.lite.locize.app
LOCIZE_PROJECT_ID=
LOCIZE_VERSION=latest
LOCIZE_TIMEOUT=10

# VTJ connection via the City of Helsinki API Gateway
VTJ_HEL_ENDPOINT=http://localhost:8080/api/HenkilonTunnuskysely
VTJ_HEL_SHARED_SECRET_HEADER=
VTJ_HEL_SHARED_SECRET=
VTJ_HEL_TIMEOUT=10
# Serve the VTJ mock from this app instead of running vtj.testing.mock_server separately.
# When on, set VTJ_HEL_ENDPOINT=http://localhost:8001/vtj-mock/api/HenkilonTunnuskysely (runserver port)
VTJ_MOCK_ENABLED=off

# Test-data cleanup API for e2e tests (/test-data/). Never enable in production.
TEST_DATA_API_ENABLED=off
# Shared secret sent in the X-Test-Data-Api-Key header; requests are refused while empty
TEST_DATA_API_KEY=

# Logging configuration
VETY_LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=ERROR
ROOT_LOG_LEVEL=ERROR
