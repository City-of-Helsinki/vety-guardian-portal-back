
SECRET_KEY=

DEBUG=on

ALLOWED_HOSTS=vety-guardian-portal-back.example.fi

# Database
DB_NAME=vetyguardiandb
DB_USER=vetyuser
DB_PASSWORD=vetypw
DB_HOST=localhost
DB_PORT=5433

# Cross-Origin Resource Sharing (django-cors-headers / corsheaders) settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# VTJ connection via the City of Helsinki API Gateway
VTJ_HEL_ENDPOINT=http://localhost:8080/api/HenkilonTunnuskysely
VTJ_HEL_SHARED_SECRET_HEADER=
VTJ_HEL_SHARED_SECRET=
VTJ_HEL_TIMEOUT=10

# Logging configuration
VETY_LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=ERROR
ROOT_LOG_LEVEL=ERROR
