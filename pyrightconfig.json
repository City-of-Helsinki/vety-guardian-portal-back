{
  "typeCheckingMode": "standard",
  /*
  "typeCheckingMode": "strict",
  "typeCheckingMode": "standard",
  "typeCheckingMode": "basic",
  "ignore": ["celery"]
  */
  "reportMissingTypeStubs": false,
  "reportIncompatibleVariableOverride": false,
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/__editable__.*",
    "**/.venv",
    "**/.*",
    "**/migrations/*.py"
  ]
}
